@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Routing
@inject ILogger<MainLayout> Logger

<div class="shell">
    <nav class="sidebar">
        <div class="brand"><img src="img/logo-mark.png" alt="" class="brand-logo" />J.R Studio</div>

        <NavLink class="nav-item" href="" Match="NavLinkMatch.All">
            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="3" width="7" height="9" rx="1.5" /><rect x="14" y="3" width="7" height="5" rx="1.5" /><rect x="14" y="12" width="7" height="9" rx="1.5" /><rect x="3" y="16" width="7" height="5" rx="1.5" /></svg>
            Dashboard
        </NavLink>
        <NavLink class="nav-item" href="projetos">
            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 7l3-4h5l2 2h8v13a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V7z" /></svg>
            Projetos
        </NavLink>
        <NavLink class="nav-item" href="biblioteca">
            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="3" width="18" height="18" rx="2" /><circle cx="8.5" cy="9.5" r="1.8" /><path d="M21 15l-5-5-9 9" /></svg>
            Biblioteca
        </NavLink>
        <NavLink class="nav-item" href="configuracoes">
            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="3" /><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z" /></svg>
            Configurações
        </NavLink>

        <div class="nav-spacer"></div>

        <TimerWidget />
    </nav>

    <main class="content">
        <LoggingErrorBoundary @ref="_errorBoundary">
            <ChildContent>
                @Body
            </ChildContent>
            <ErrorContent>
                <div class="panel" style="border:0.5px solid var(--danger)">
                    <h3 style="color:var(--danger)">Ocorreu um erro nesta tela</h3>
                    <p class="page-sub" style="margin-bottom:12px">Os detalhes foram registrados no arquivo de log (JRStudio_logs.txt).</p>
                    <button @onclick="() => _errorBoundary?.Recover()">Tentar novamente</button>
                </div>
            </ErrorContent>
        </LoggingErrorBoundary>
    </main>
</div>

<ConfirmDialog />

@code {
    private LoggingErrorBoundary? _errorBoundary;

    protected override void OnParametersSet()
    {
        _errorBoundary?.Recover();
    }
}
