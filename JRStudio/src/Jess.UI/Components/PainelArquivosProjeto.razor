@inject IArquivoService ArquivoService
@inject IFileDialogService FileDialogService
@inject ConfirmState ConfirmState

<div class="toolbar">
    <span></span>
    <div style="display:flex;gap:8px;flex-shrink:0">
        <button @onclick="AbrirVincularExistente">Vincular existente</button>
        <button class="primary" @onclick="ImportarAsync">+ Importar arquivos</button>
    </div>
</div>

<FiltroArquivos Arquivos="_arquivos" TagsDisponiveis="_tagsDisponiveis"
                TagAtiva="@_tagAtiva" OnTagSelecionada="tag => _tagAtiva = tag"
                TermoBusca="@_termoBusca" OnTermoBuscaAlterado="termo => _termoBusca = termo" />

@if (_carregando)
{
    <p class="page-sub">Carregando arquivos...</p>
}
else
{
    var lista = ArquivoFiltro.PorBusca(ArquivoFiltro.PorTag(_arquivos, _tagAtiva), _termoBusca);
    @if (lista.Count == 0)
    {
        <p class="page-sub">Nenhum arquivo vinculado a este projeto ainda.</p>
    }
    else
    {
        <div class="file-grid">
            @foreach (var arquivo in lista)
            {
                <ArquivoCard @key="arquivo.Id" Arquivo="arquivo"
                             MostrarDesvincular="true"
                             OnFavoritar="() => FavoritarAsync(arquivo)"
                             OnEditarTags="() => AbrirTags(arquivo)"
                             OnDesvincular="() => DesvincularAsync(arquivo)"
                             OnExcluir="() => ExcluirAsync(arquivo)" />
            }
        </div>
    }
}

<ArquivoTagsModal IsOpen="_modalTagsAberto" Arquivo="_arquivoEditandoTags" OnClose="() => _modalTagsAberto = false" OnSubmit="SalvarTagsAsync" />
<VincularArquivoModal IsOpen="_modalVincularAberto" Disponiveis="_disponiveisParaVincular" OnClose="() => _modalVincularAberto = false" OnVincular="VincularAsync" />

@code {
    private const string FiltroImportacao =
        "Imagens e documentos (*.jpg;*.jpeg;*.png;*.gif;*.webp;*.bmp;*.pdf;*.doc;*.docx;*.txt)|*.jpg;*.jpeg;*.png;*.gif;*.webp;*.bmp;*.pdf;*.doc;*.docx;*.txt|Todos os arquivos (*.*)|*.*";

    private List<ArquivoDto> _arquivos = [];
    private List<string> _tagsDisponiveis = [];
    private string? _tagAtiva;
    private string? _termoBusca;
    private bool _carregando = true;
    private int? _ultimoProjetoId;

    private bool _modalTagsAberto;
    private ArquivoDto? _arquivoEditandoTags;

    private bool _modalVincularAberto;
    private List<ArquivoDto> _disponiveisParaVincular = [];

    [Parameter, EditorRequired]
    public int ProjetoId { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (_ultimoProjetoId == ProjetoId)
        {
            return;
        }

        _ultimoProjetoId = ProjetoId;
        await CarregarAsync();
    }

    private async Task CarregarAsync()
    {
        _carregando = true;
        _arquivos = (await ArquivoService.ListarAsync(ProjetoId)).ToList();
        _tagsDisponiveis = _arquivos.SelectMany(a => a.Tags).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(t => t).ToList();
        _carregando = false;
    }

    private async Task ImportarAsync()
    {
        var arquivos = await FileDialogService.EscolherArquivosParaImportarAsync(FiltroImportacao);
        if (arquivos.Length == 0)
        {
            return;
        }

        foreach (var caminho in arquivos)
        {
            await ArquivoService.ImportarAsync(caminho, projetoIds: [ProjetoId]);
        }

        await CarregarAsync();
    }

    private async Task AbrirVincularExistente()
    {
        var todos = await ArquivoService.ListarAsync();
        _disponiveisParaVincular = todos.Where(a => !a.ProjetoIds.Contains(ProjetoId)).ToList();
        _modalVincularAberto = true;
    }

    private async Task VincularAsync(ArquivoDto arquivo)
    {
        await ArquivoService.VincularProjetoAsync(arquivo.Id, ProjetoId);
        _modalVincularAberto = false;
        await CarregarAsync();
    }

    private async Task DesvincularAsync(ArquivoDto arquivo)
    {
        await ArquivoService.DesvincularProjetoAsync(arquivo.Id, ProjetoId);
        await CarregarAsync();
    }

    private async Task FavoritarAsync(ArquivoDto arquivo)
    {
        await ArquivoService.AlternarFavoritoAsync(arquivo.Id);
        await CarregarAsync();
    }

    private void AbrirTags(ArquivoDto arquivo)
    {
        _arquivoEditandoTags = arquivo;
        _modalTagsAberto = true;
    }

    private async Task SalvarTagsAsync(List<string> tags)
    {
        if (_arquivoEditandoTags is null)
        {
            return;
        }

        await ArquivoService.AtualizarTagsAsync(_arquivoEditandoTags.Id, tags);
        _modalTagsAberto = false;
        await CarregarAsync();
    }

    private async Task ExcluirAsync(ArquivoDto arquivo)
    {
        var confirmado = await ConfirmState.ConfirmarAsync(
            $"Excluir \"{arquivo.NomeArquivo}\" da biblioteca? Essa ação não pode ser desfeita (o arquivo também deixa de existir para outros projetos vinculados).",
            "Excluir arquivo");

        if (!confirmado)
        {
            return;
        }

        await ArquivoService.ExcluirAsync(arquivo.Id);
        await CarregarAsync();
    }
}
